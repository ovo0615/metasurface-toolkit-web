# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# 本機開發工具設定（含本機路徑，不應公開）
.claude/
# 注意：frontend/dist（生產環境建置成品）刻意保留進版控，
# 讓 GitHub 下載後不需安裝 Node.js 即可執行 start.bat。

# AEDT 模擬結果與暫存（只保留 .aedt / .aedtz 專案原始檔）
*.aedtresults/
*.lock
*.asol
*.aedt.lock

# 後端執行期上傳的靜態檔案
backend/app/static/

# 大型媒體檔（示範影片等）
*.mp4

# Office 暫存檔
~$*

# 作業系統
Thumbs.db
.DS_Store

# AEDT 自動存檔
*.aedt.auto
*.lock.json

# AEDT 執行紀錄
batch.log
*.log

# 模擬結果圖檔（執行期產生）
backend/app/static/results/
